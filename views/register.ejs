<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>登録</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>

<h1>
登録
</h1>

<form action="/register" method="POST">

<input
type="text"
name="name"
placeholder="名前"
required
>

<input
type="email"
name="email"
placeholder="メール"
required
>

<input
type="password"
name="password"
placeholder="パスワード"
required
>

<button>
登録
</button>

</form>

</body>
</html>